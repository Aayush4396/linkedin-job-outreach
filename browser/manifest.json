{
  "manifest_version": 3,
  "name": "HireMate local post search",
  "description": "Run a search from your local HireMate dashboard and review visible LinkedIn posts.",
  "version": "0.1.3",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*", "http://localhost/*"],
    "js": ["dashboard.js"]
  }]
}
